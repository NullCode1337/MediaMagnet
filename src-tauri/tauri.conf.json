{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MediaMagnet",
  "mainBinaryName": "MediaMagnet",
  "version": "0.5.0",
  "identifier": "com.nullcode1337.mediamagnet",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "MediaMagnet",
        "width": 800,
        "height": 650,
        "minHeight": 200,
        "backgroundColor": "#2e2e32",
        "alwaysOnTop": true,
        "dragDropEnabled": true,
        "decorations": true,
        "transparent": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/yt-dlp",
      "binaries/gallery-dl"
    ]
  }
}
