{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MediaMagnet",
  "mainBinaryName": "MediaMagnet",
  "version": "0.7.0",
  "identifier": "com.nullcode1337.mediamagnet",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run --cwd ../web dev",
    "beforeBuildCommand": "bun run --cwd ../web build"
  },
  "app": {
    "windows": [
      {
        "title": "MediaMagnet",
        "width": 850,
        "height": 650,
        "minHeight": 200,
        "minWidth": 200,
        "backgroundColor": "#2e2e32",
        "alwaysOnTop": true,
        "dragDropEnabled": true,
        "decorations": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "opener": {
      "requireLiteralLeadingDot": false
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI4MUI3Q0E3RDMyNzk3MDMKUldRRGx5ZlRwM3didUErdHFMNGVldmZrQXVkZlErSEFqVDRBVDlGVFVjTGlzKzd1MzBQY254OGUK",
      "endpoints": [
        "https://github.com/NullCode1337/MediaMagnet/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "binaries"
    ]
  }
}
