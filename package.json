{
  "name": "mediamagnet",
  "private": true,
  "version": "0.6.1",
  "description": "Download any and all media",
  "author": {
    "name": "NullCode1337",
    "email": "contact.nullcode@proton.me"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "build:server": "bun run --cwd apps/web build && cargo build --release -p mm-server --bin mediamagnet-server",
    "package:server": "bash scripts/package-server.sh",
    "check": "bun run --cwd apps/web check && bun run --cwd packages/client check",
    "generate:api": "bun run --cwd packages/client generate",
    "tauri": "bun run --cwd apps/desktop tauri"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.3",
    "@eslint/js": "^10.0.1",
    "@internationalized/date": "^3.12.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tauri-apps/cli": "^2.10.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^25.5.0",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.15.2",
    "globals": "^17.4.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "svelte-check": "^4.4.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.0"
  }
}
